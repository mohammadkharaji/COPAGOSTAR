<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#0A0E1A"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="نبض فروش کوپا گستر"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ویجت اختصاصی صفحه اصلی اندروید"
        android:textColor="#94A3B8"
        android:textSize="14sp"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btn_pin_widget"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="افزودن ویجت به صفحه اصلی گوشی"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="#0071E3"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_open_dashboard"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="ورود به داشبورد وب"
        android:textColor="#E2E8F0"
        android:textSize="14sp"
        android:backgroundTint="#1E293B" />

</LinearLayout>
